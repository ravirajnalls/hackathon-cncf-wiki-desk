TERAC_ROUND_BUDGET_USD=40     # agent won't launch a round quoted above this
TERAC_ITEMS=4                 # wiki sections per study

# Claude subprocess tool allowlist (MCP names must match `claude mcp list`)
# CLAUDE_ALLOWED_TOOLS=Bash Read Write Edit Glob Grep WebFetch mcp__whop mcp__terac mcp__exa

